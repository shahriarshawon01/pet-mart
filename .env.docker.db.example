# MySQL container settings. Copy to .env.docker.db (gitignored) and fill in.
# These are applied only when the data volume is created for the first time.

# Root is for administration only; the app never uses it.
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=pet_mart_db
# App user: must match DB_USERNAME / DB_PASSWORD in .env.docker
MYSQL_USER=petmart
MYSQL_PASSWORD=
