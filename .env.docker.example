# App container settings for docker compose. Copy to .env.docker (gitignored) and fill in.
# Values here are read directly by Laravel; the container does not write a .env file.

APP_NAME=PetMart
# Production: APP_ENV=production and APP_DEBUG=false
APP_ENV=local
APP_DEBUG=false
# Generate with: php artisan key:generate --show   (use a different key per environment)
APP_KEY=
APP_URL=http://localhost:8080

# Customer site origin(s) allowed to call the API (comma-separated, exact origins)
FRONTEND_URL=http://localhost:8082
CORS_ALLOWED_ORIGINS=http://localhost:8082
SANCTUM_EXPIRATION=43200

LOG_CHANNEL=stderr
LOG_LEVEL=info

# App database user (not root). Must match MYSQL_USER / MYSQL_PASSWORD in .env.docker.db
DB_CONNECTION=mysql
DB_DATABASE=pet_mart_db
DB_USERNAME=petmart
DB_PASSWORD=

CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Run `migrate --force` on container start. Set false when running more than one app container.
RUN_MIGRATIONS=true
